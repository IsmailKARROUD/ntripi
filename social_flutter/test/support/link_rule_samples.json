{
  "_about": "One list, two detectors: the server's validators/links.py find_link (social_api/test/test_link_rule.py) and the app's findLink (test/core/text/link_rule_test.dart) must both return 'match' for 'text' — the exact characters quoted back to the user, or null when the text holds no link. Add a case here, never to one side only.",
  "samples": [
    {"text": "Book on https://booking.com/hotel now", "match": "https://booking.com/hotel", "why": "web address"},
    {"text": "see http://x.example", "match": "http://x.example", "why": "plain http"},
    {"text": "ftp://files.example/x", "match": "ftp://files.example/x", "why": "any scheme://"},
    {"text": "Open javascript:alert(1)", "match": "javascript:alert(1)", "why": "script scheme"},
    {"text": "Write to mailto:me@x.com", "match": "mailto:me@x.com", "why": "mailto: comes before the address inside it"},
    {"text": "img data:image/png;base64,AAAA", "match": "data:image/png;base64,AAAA", "why": "data: with a type"},
    {"text": "Go to www.booking.com today", "match": "www.booking.com", "why": "www."},
    {"text": "WWW.EXAMPLE.ORG", "match": "WWW.EXAMPLE.ORG", "why": "www. in capitals"},
    {"text": "[our site](https://x.example)", "match": "[our site](https://x.example)", "why": "markdown link"},
    {"text": "![pic](https://x.example/p.jpg)", "match": "![pic](https://x.example/p.jpg)", "why": "markdown image"},
    {"text": "see [label](relative/page)", "match": "[label](relative/page)", "why": "markdown link without a scheme"},
    {"text": "[1]: https://x.example", "match": "[1]: https://x.example", "why": "markdown reference definition"},
    {"text": "Contact me: anna@gmail.com", "match": "anna@gmail.com", "why": "e-mail address"},
    {"text": "Book on booking.com.", "match": "booking.com", "why": "bare site name, sentence dot left out"},
    {"text": "Stay at hotel-atlas.ma, great", "match": "hotel-atlas.ma", "why": "bare site name, country domain"},
    {"text": "anna.paris", "match": "anna.paris", "why": "a dotted handle ending in a city domain"},
    {"text": "Find us on example.com/menu", "match": "example.com/menu", "why": "a site name's path is quoted too"},
    {"text": "BOOKING.COM", "match": "BOOKING.COM", "why": "domain in capitals"},
    {"text": "Fly with x.co.uk", "match": "x.co.uk", "why": "two-level domain"},
    {"text": "Follow @booking.com", "match": "booking.com", "why": "a site name after @ is still a site name"},
    {"text": "We had lunch.Tours start at 9", "match": "lunch.Tours", "why": "missing space before a word that is a domain — an accepted false alarm"},
    {"text": "زيارة القاهرة.مصر", "match": "القاهرة.مصر", "why": "Arabic site name"},
    {"text": "Walk 3.5km to the beach", "match": null, "why": "a decimal is not a site name"},
    {"text": "Bring sunscreen, e.g. SPF 50", "match": null, "why": "e.g."},
    {"text": "Open 9 a.m. to 5 p.m.", "match": null, "why": "a.m. / p.m."},
    {"text": "St.Louis is lovely", "match": null, "why": "abbreviation before a word that is not a domain"},
    {"text": "Data: 5GB per day", "match": null, "why": "a 'Data:' label is not a data: address"},
    {"text": "Tel: +212 600 000 000", "match": null, "why": "tel is not a refused scheme"},
    {"text": "Cost: 12.50 EUR", "match": null, "why": "price"},
    {"text": "Version 2.0 of the map", "match": null, "why": "version number"},
    {"text": "Meet at 10.30 near the gate", "match": null, "why": "time"},
    {"text": "[sic] (the sign said so)", "match": null, "why": "brackets that are not a markdown link"},
    {"text": "Use #travel and @anna", "match": null, "why": "a hashtag and a mention"},
    {"text": "Note: mailto: needs an address", "match": null, "why": "a scheme word followed by a space"},
    {"text": "http is old, https is better", "match": null, "why": "the words alone"},
    {"text": "C'est l'été... on y va", "match": null, "why": "ellipsis"},
    {"text": "مرحبا بكم في المغرب.", "match": null, "why": "Arabic sentence"},
    {"text": "我们去了北京。中国很大", "match": null, "why": "Chinese sentence"},
    {"text": "", "match": null, "why": "empty"}
  ]
}
