# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Full PostgreSQL connection URL.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/ntripi_db

# JWT signing secret — generate with: openssl rand -hex 32
# This must be kept secret in production.
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm — HS256 is standard and sufficient for this use case.
ALGORITHM=HS256

# Token expiry in minutes. 1440 = 24 hours.
# In production you might lower this and implement refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to True during development to enable hot-reload friendly CORS (all origins allowed).
# In production, set to False and configure ALLOWED_ORIGINS.
DEBUG=True

# Production-only: the exact frontend domain that is allowed to make cross-origin requests.
# Only used when DEBUG=False.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Base URL used when building share links (e.g. the URL pasted into WhatsApp).
# In production: SHARE_BASE_URL=https://ntripi.app
SHARE_BASE_URL=http://localhost:8000

# Optional Android APK download URL shown on the homepage.
# Leave empty until Ticket 9 ships the binary.
# Example: ANDROID_DOWNLOAD_URL=/downloads/ntripi-latest.apk
ANDROID_DOWNLOAD_URL=

# Storage backend — "filesystem" (local disk) or "r2" (Cloudflare R2).
# For filesystem: mount a persistent Railway volume at STORAGE_FILESYSTEM_PATH.
# For r2 (the production setup — R2 behind a proxied custom domain is what puts
# images in front of Cloudflare's CSAM scanning): set STORAGE_BACKEND=r2 and
# fill in all R2_* vars below. Keep STORAGE_PUBLIC_URL_PREFIX set either way;
# legacy relative URLs are still validated against it.
STORAGE_BACKEND=filesystem
STORAGE_FILESYSTEM_PATH=/app/uploads
STORAGE_PUBLIC_URL_PREFIX=/uploads

# Google Sign-In — OAuth 2.0 client IDs from Google Cloud Console.
# The backend accepts a Google ID token whose `aud` matches one of these.
# WEB:     used by web + as serverClientId on Android/iOS (Android's aud = this).
# IOS:     native iOS client id.
# ANDROID: bound by package + SHA-1 in the console; listed here for completeness.
# Example: GOOGLE_WEB_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Transactional email (password reset + email verification).
# EMAIL_BACKEND: "console" logs the link to the server output (dev, no key
# needed); "resend" sends via Resend. Verify the ntripi.app domain in Resend
# (SPF/DKIM DNS in Cloudflare), then set EMAIL_BACKEND=resend + RESEND_API_KEY.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Ntripi <noreply@ntripi.app>

# Cloudflare R2 — only required when STORAGE_BACKEND=r2.
#
# R2_ENDPOINT: your account's S3-compatible API endpoint.
#   Format: https://<account-id>.r2.cloudflarestorage.com
#   Find it in: Cloudflare Dashboard → R2 → your bucket → Settings → S3 API.
#
# R2_PUBLIC_URL: the public URL base for serving uploaded files. In production
#   this MUST be a custom domain attached to the bucket AND left PROXIED (orange
#   cloud) — Cloudflare's CSAM Scanning Tool only sees traffic through the zone,
#   so a pub-<hash>.r2.dev URL is invisible to it and leaves the whole
#   child-safety layer doing nothing. Use r2.dev for local experiments only.
#   Set it in: Cloudflare Dashboard → R2 → your bucket → Settings → Custom Domains.
#
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 API token credentials.
#   Generate in: Cloudflare Dashboard → R2 → Manage R2 API Tokens.
#   Permissions needed: Object Read & Write on the target bucket.
#
# With STORAGE_BACKEND=r2, missing or misspelled R2_* vars now FAIL the boot
# rather than silently falling back to the filesystem backend.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ntripi-images
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://images.ntripi.app

# ---------------------------------------------------------------------------
# Text moderation
# ---------------------------------------------------------------------------
# TEXT_MODERATION_PROVIDER: "disabled" (default — no scanning, behaves exactly
# as before this feature), "openai" (OpenAI Moderation API, falling back to the
# local classifier on failure), or "local" (alt-profanity-check, offline).
# Startup FAILS if you select "openai" without a key — a silent downgrade to
# the wordlist would be worse than not booting.
TEXT_MODERATION_PROVIDER=disabled
OPENAI_API_KEY=
TEXT_MODERATION_MODEL=omni-moderation-latest
TEXT_MODERATION_TIMEOUT_SECONDS=5.0
# Verdicts are cached by hash(text + model + policy version) — no raw text and
# no user reference is stored.
TEXT_MODERATION_CACHE_TTL_DAYS=30
# Reviewed decisions are purged after this long; unreviewed ones never are
# (they are the moderator queue).
TEXT_MODERATION_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Moderation sweep (SLA enforcement, post-outage re-checks, cache purge)
# ---------------------------------------------------------------------------
# Hours before an unreviewed report is auto-actioned. The legal deadline is 24h
# from when the report was FILED, and the sweep only runs periodically, so this
# is capped at 22 to leave room for a missed run during a deploy.
MODERATION_SLA_HOURS=20
# Bearer token for POST /internal/moderation-sweep. UNSET = the endpoint 404s,
# i.e. the feature is invisible rather than merely locked. Generate with:
#   openssl rand -hex 32
SWEEP_TOKEN=
# The sweep must be driven by something or SLA hides and post-outage re-checks
# never run. True = a timer inside the app, which needs no scheduler and no
# token; the simplest choice on a single instance and the only one that works in
# local dev. The alternative is an external scheduler calling the endpoint above.
SWEEP_IN_PROCESS=False
# How often that timer fires. Floored at 60s. A deploy restarts the timer, so an
# interval longer than the gap between deploys may never actually fire.
SWEEP_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
# Distinct reporters required before content is hidden immediately, per
# category. One person reporting repeatedly counts once.
REPORT_HIDE_THRESHOLDS=csam:1,sexual_content:1,violence_threat:1,hate_speech:2,harassment:2,other:3,spam:4
# slowapi limit for POST /reports (per-user and per-IP daily limits are also
# enforced against the database).
REPORT_RATE_LIMIT=10/hour

# Published abuse contact. MUST match the address shown in the app and on the
# app-store listing — reviewers compare them. Use the domain address.
ABUSE_CONTACT_EMAIL=abuse@ntripi.app

# Where operator notifications go (new reports, flagged uploads, bug reports,
# and moderation degradation alerts). Unset = logged only, never sent — so the
# report and bug-report queues fill up with nobody told. Production: ops@ntripi.app,
# which must also be Cloudflare's CSAM Scanning notification address.
OPERATOR_EMAIL=

# ---------------------------------------------------------------------------
# Image moderation (AWS Rekognition) — see CLAUDE.md
# ---------------------------------------------------------------------------
MODERATION_ENABLED=False
MODERATION_AWS_ACCESS_KEY_ID=
MODERATION_AWS_SECRET_ACCESS_KEY=
MODERATION_AWS_REGION=
MODERATION_REJECT_THRESHOLD=80
MODERATION_FLAG_THRESHOLD=50

# Known-CSAM hash matching has NO app config: Cloudflare's CSAM Scanning Tool
# does it at the edge on served content. It requires STORAGE_BACKEND=r2 behind a
# PROXIED custom domain (see the R2 block above) and is enabled in the Cloudflare
# dashboard. Full pipeline + operator procedure: docs/media_pipeline_spec.md.

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) — 404s entirely unless BOTH are set
# ---------------------------------------------------------------------------
ADMIN_BASIC_USERNAME=
ADMIN_BASIC_PASSWORD=
ADMIN_SESSION_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# Jira hand-off — the "Create Jira issue" button on /admin/bugs.
# The button is hidden unless BASE_URL + EMAIL + API_TOKEN + PROJECT_KEY are all
# set. Free: the Jira Cloud REST API has no per-call charge and the token is
# minted at id.atlassian.com -> Security -> API tokens.
# ---------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# The project KEY as shown on your board (e.g. NTRIPI), not a numeric id.
JIRA_PROJECT_KEY=
# Issue type NAME; must exist in that project. A wrong value here is the most
# likely first failure — Jira's 400 body names the field and the dashboard
# shows it back to you.
JIRA_ISSUE_TYPE=Bug
JIRA_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Push notifications (FCM HTTP v1) — OFF unless BOTH of PROJECT_ID and
# SERVICE_ACCOUNT_JSON are set. Unset, nothing is sent and no error is raised:
# the in-app feed and the client's 60s badge poll behave exactly as before.
# Push is a latency improvement over that poll, never a replacement — FCM
# delivery is best-effort and OEM battery managers drop it routinely.
#
# Free: FCM carries no per-message charge. Needs zero new Python packages —
# google-auth (already installed for Google Sign-In) mints the bearer token.
#
# Setup: Firebase console -> attach to the EXISTING Google Cloud project that
# holds the Sign-In OAuth clients (a second project would drift), register the
# iOS + Android apps under com.ismailkarroud.ntripi, enable "Firebase Cloud
# Messaging API (V1)", and upload an APNs .p8 auth key for iOS.
# ---------------------------------------------------------------------------
# Firebase -> Project settings -> General -> Project ID (the slug).
FCM_PROJECT_ID=
# The WHOLE service-account JSON on one line, not a file path — Railway gives
# us no filesystem to drop a key file onto. Firebase -> Project settings ->
# Service accounts -> Generate new private key. This one IS a secret.
FCM_SERVICE_ACCOUNT_JSON=
FCM_TIMEOUT_SECONDS=10
# A device that has not checked in for this long is presumed uninstalled and is
# purged by the sweep. Tokens FCM reports dead are pruned immediately instead.
DEVICE_TOKEN_RETENTION_DAYS=180
