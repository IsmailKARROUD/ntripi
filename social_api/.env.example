# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Full PostgreSQL connection URL.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/ntripi_db

# JWT signing secret — generate with: openssl rand -hex 32
# This must be kept secret in production.
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm — HS256 is standard and sufficient for this use case.
ALGORITHM=HS256

# Token expiry in minutes. 1440 = 24 hours.
# In production you might lower this and implement refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to True during development to enable hot-reload friendly CORS (all origins allowed).
# In production, set to False and configure ALLOWED_ORIGINS.
DEBUG=True

# Production-only: the exact frontend domain that is allowed to make cross-origin requests.
# Only used when DEBUG=False.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Base URL used when building share links (e.g. the URL pasted into WhatsApp).
# In production: SHARE_BASE_URL=https://ntripi.app
SHARE_BASE_URL=http://localhost:8000

# Optional Android APK download URL shown on the homepage.
# Leave empty until Ticket 9 ships the binary.
# Example: ANDROID_DOWNLOAD_URL=/downloads/ntripi-latest.apk
ANDROID_DOWNLOAD_URL=

# Storage backend — "filesystem" (local disk) or "r2" (Cloudflare R2).
# For filesystem: mount a persistent Railway volume at STORAGE_FILESYSTEM_PATH.
# For r2: set STORAGE_BACKEND=r2 and fill in all R2_* vars below.
STORAGE_BACKEND=filesystem
STORAGE_FILESYSTEM_PATH=/app/uploads
STORAGE_PUBLIC_URL_PREFIX=/uploads

# Google Sign-In — OAuth 2.0 client IDs from Google Cloud Console.
# The backend accepts a Google ID token whose `aud` matches one of these.
# WEB:     used by web + as serverClientId on Android/iOS (Android's aud = this).
# IOS:     native iOS client id.
# ANDROID: bound by package + SHA-1 in the console; listed here for completeness.
# Example: GOOGLE_WEB_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Transactional email (password reset + email verification).
# EMAIL_BACKEND: "console" logs the link to the server output (dev, no key
# needed); "resend" sends via Resend. Verify the ntripi.app domain in Resend
# (SPF/DKIM DNS in Cloudflare), then set EMAIL_BACKEND=resend + RESEND_API_KEY.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Ntripi <noreply@ntripi.app>

# Cloudflare R2 — only required when STORAGE_BACKEND=r2.
#
# R2_ENDPOINT: your account's S3-compatible API endpoint.
#   Format: https://<account-id>.r2.cloudflarestorage.com
#   Find it in: Cloudflare Dashboard → R2 → your bucket → Settings → S3 API.
#
# R2_PUBLIC_URL: the public URL base for serving uploaded files.
#   Options:
#     • Custom domain (recommended): https://images.ntripi.app
#     • r2.dev subdomain (quick start): https://pub-<hash>.r2.dev
#   Find it in: Cloudflare Dashboard → R2 → your bucket → Settings → Public Access.
#
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 API token credentials.
#   Generate in: Cloudflare Dashboard → R2 → Manage R2 API Tokens.
#   Permissions needed: Object Read & Write on the target bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ntripi-images
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-YOUR_HASH.r2.dev
