# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Full PostgreSQL connection URL.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/ntripi_db

# JWT signing secret — generate with: openssl rand -hex 32
# This must be kept secret in production.
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm — HS256 is standard and sufficient for this use case.
ALGORITHM=HS256

# Token expiry in minutes. 1440 = 24 hours.
# In production you might lower this and implement refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to True during development to enable hot-reload friendly CORS (all origins allowed).
# In production, set to False and configure ALLOWED_ORIGINS.
DEBUG=True

# Production-only: the exact frontend domain that is allowed to make cross-origin requests.
# Only used when DEBUG=False.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Base URL used when building share links (e.g. the URL pasted into WhatsApp).
# In production: SHARE_BASE_URL=https://ntripi.app
SHARE_BASE_URL=http://localhost:8000

# Optional Android APK download URL shown on the homepage.
# Leave empty until Ticket 9 ships the binary.
# Example: ANDROID_DOWNLOAD_URL=/downloads/ntripi-latest.apk
ANDROID_DOWNLOAD_URL=
